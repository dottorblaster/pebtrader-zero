{
  "name": "pebtrader-zero",
  "author": "Alessio Biancalana",
  "version": "0.3.0",
  "description": "View the state of your CardTrader Zero orders on a Pebble watch.",
  "keywords": [
    "pebble-app",
    "pebble",
    "cardtrader",
    "trading-cards",
    "orders"
  ],
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "PebTrader Zero",
    "uuid": "61efda9c-bb1f-4c69-a7be-b71065ce31c7",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "capabilities": [
      "configurable"
    ],
    "messageKeys": [
      "API_TOKEN",
      "ROLE",
      "CT0_ONLY",
      "REFRESH_MINUTES",
      "COMMAND",
      "ORDER_ID",
      "TYPE",
      "STATUS",
      "ERROR_CODE",
      "ERROR_MESSAGE",
      "SEQ",
      "CHUNK_INDEX",
      "CHUNK_COUNT",
      "DATA",
      "API_BASE",
      "CT0_GROUP"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
